{
  "name": "wkflo-ui",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "npm install --prefix chat-widget && npm run widget-build --prefix chat-widget && vite build",
    "build:local": "npm install --prefix chat-widget && npm run widget-build --prefix chat-widget && vite build --mode development",
    "build:staging": "npm install --prefix chat-widget && npm run widget-build --prefix chat-widget && vite build --mode staging",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:build": "vite build --config e2e/vite.e2e.config.ts --mode e2e",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "e2e:typecheck": "tsc -p e2e/tsconfig.json"
  },
